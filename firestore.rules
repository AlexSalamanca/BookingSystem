rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, replace PASTE_ADMIN_UID, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.uid == "PASTE_ADMIN_UID"; }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }

    // everyone sees the schedule (function name, unit, times); each browser writes only its own list
    match /bookings/{uid} {
      allow read: if true;
      allow write: if isSelf(uid) || isAdmin();
    }
    // name, phone, email, signature: only the resident who booked and the office
    match /contacts/{uid} {
      allow read, write: if isSelf(uid) || isAdmin();
    }
    // email log written by the sender
    match /notices/{bookingId} {
      allow read, write: if isAdmin();
    }
    // short booking leases so two people can't take the same slot at once
    match /locks/{date} {
      allow read, write: if request.auth != null;
    }
  }
}
